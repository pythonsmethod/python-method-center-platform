{
  "expo": {
    "name": "Python Method Center",
    "slug": "python-method-center",
    "scheme": "pythonmethodcenter",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "plugins": [
      "expo-router",
      [
        "expo-dev-client",
        {
          "launchMode": "most-recent"
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Разрешите Python Method Center записывать голосовые сообщения для команды центра.",
          "enableBackgroundRecording": false,
          "enableBackgroundPlayback": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.pythonsmethod.center"
    },
    "android": {
      "package": "com.pythonsmethod.center"
    },
    "web": {
      "bundler": "metro"
    },
    "extra": {
      "eas": {
        "projectId": "e5cd7595-af5f-4fdd-a528-82eb20231fe2"
      }
    }
  }
}
