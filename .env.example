NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Never expose this with NEXT_PUBLIC_ and never commit a real key.
SUPABASE_SERVICE_ROLE_KEY=

# Automatic RU/EN Stripe Checkout. No static Payment Links are needed.
# Keep off until PR #215 migration + isolated Stripe test payments pass.
STRIPE_CHECKOUT_ENABLED=false
STRIPE_CHECKOUT_MODE=test
# Explicit origin for THIS environment; https://... with no path.
# Local test mode may use http://localhost:3000.
STRIPE_CHECKOUT_RETURN_ORIGIN=
# Enable only after Stripe Tax has been configured for the business.
STRIPE_CHECKOUT_AUTOMATIC_TAX=false

# Payment methods for people whose cards Stripe cannot accept (page
# /payment/other). Each block appears only when filled in; multi-line
# values are shown as written.
PAYMENT_ALT_BANK=
PAYMENT_ALT_CRYPTO=
PAYMENT_ALT_WISE=
PAYMENT_ALT_OTHER=

# Server-only Stripe integration (webhook + automatic payment recording).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# AI assistants (server-only).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-sol
# Realtime voice pilot. Server-only; disabled until isolated staging validation.
# Existing OPENAI_API_KEY is the fallback. No keys are created automatically.
ANHAM_REALTIME_ENABLED=false
ANHAM_REALTIME_STAFF_ONLY=false
ANHAM_REALTIME_TEST_EMAILS=
OPENAI_REALTIME_API_KEY=
OPENAI_REALTIME_MODEL=gpt-realtime
OPENAI_REALTIME_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
OPENAI_REALTIME_VOICE=marin
# Independent random signing secret, at least 32 characters; never NEXT_PUBLIC_.
ANHAM_REALTIME_SESSION_SECRET=
ANHAM_REALTIME_MAX_SECONDS=300
ANHAM_REALTIME_DAILY_SESSIONS=10
# Comma-separated login emails allowed to use the private founder/Karen AI
# and edit its knowledge base. Access fails closed when this is empty.
KAREN_EMAILS=

# Public assistant protection (optional — safe defaults are built in).
# PUBLIC_ASSISTANT_MODE: open (default) | registered_only | off
PUBLIC_ASSISTANT_MODE=
ASSISTANT_DAILY_LIMIT_GUEST=
ASSISTANT_DAILY_LIMIT_REGISTERED=
ASSISTANT_DAILY_LIMIT_CLIENT=
ASSISTANT_DAILY_TOTAL_GUEST=
ANHAM_DEEP_DAILY_LIMIT=
# Salt for hashing visitor addresses in the daily counters (never stored raw).
ASSISTANT_USAGE_SALT=

# Saved, non-medical Anham greetings/check-ins. Enable only after the migration
# and synthetic staging acceptance. No email, push or external AI calls.
ASSISTANT_OUTREACH_ENABLED=false
# Optional comma-separated UUID allowlist for synthetic staging / limited rollout.
# Leave the variable UNSET for all eligible profiles. Empty or malformed fails closed.
# ASSISTANT_OUTREACH_PROFILE_IDS=uuid-1,uuid-2
# Shared server-only bearer secret for Vercel cron routes.
CRON_SECRET=

# Team notifications via Telegram (server-only): bot token from @BotFather
# and the chat id the team reads. Without these, notifications are logged
# with status "skipped" and nothing is sent.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Immediate email copies of support requests submitted without an account.
RESEND_API_KEY=
SUPPORT_NOTIFICATION_EMAIL=
SUPPORT_FROM_EMAIL=Python Method Center <support@pythonmethodcenter.com>

# Absolute site origin used in notification links and auth redirects.
NEXT_PUBLIC_SITE_URL=https://pythonmethodcenter.com

# Optional Google Search Console HTML-tag verification token. Domain-level
# DNS verification does not need this value.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Native mobile app store pages. Until these are set, the public website
# shows honest "Coming soon" store buttons rather than invented links.
NEXT_PUBLIC_APP_STORE_URL=
NEXT_PUBLIC_GOOGLE_PLAY_URL=

# Staff voice public internet search (requires voice pilot and source-storage migration).
ANHAM_WEB_SEARCH_ENABLED=false
OPENAI_WEB_SEARCH_MODEL=gpt-4.1

# Personal voices: enable only after provider eligibility and each owner consent.
ANHAM_CUSTOM_VOICES_ENABLED=false
ANHAM_VOICE_BUILTINS_ONLY=true
# Selected client accounts may test voice even while public rollout is off.
# Confirmed accounts also receive full client assistant capabilities in text/voice.
# Includes own-case source reads and public web search when globally enabled.
# This is not paid support; no staff tools or platform-role promotion.
ANHAM_CLIENT_VOICE_TEST_EMAILS=
ANHAM_FOUNDER_VOICE_ID=
ANHAM_FOUNDER_VOICE_CONSENT_ID=
ANHAM_KAREN_VOICE_ID=
ANHAM_KAREN_VOICE_CONSENT_ID=


# Optional product analytics: disabled until the isolated migration and consent QA pass.
PRODUCT_ANALYTICS_ENABLED=false
# Separate random secret, at least 32 characters. Never expose this in NEXT_PUBLIC_.
PRODUCT_ANALYTICS_SECRET=
# Optional PostHog landing heatmaps. No replay, form/DOM text or private-page capture.
# Requires owner-approved provider project/terms and matching data region; no account is created by code.
NEXT_PUBLIC_POSTHOG_HEATMAPS_ENABLED=false
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# Dashboard URLs: HTTPS, approved PostHog/Clarity host, no query, fragment or credentials.
# Setting a URL does not establish that the provider is connected or contains data.
PRODUCT_ANALYTICS_HEATMAP_URL=
PRODUCT_ANALYTICS_RECORDINGS_URL=
