NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Never expose this with NEXT_PUBLIC_ and never commit a real key.
SUPABASE_SERVICE_ROLE_KEY=

# Stripe Payment Links for the two support products (browser-safe URLs).
NEXT_PUBLIC_STRIPE_PAYMENT_LINK_5W=
NEXT_PUBLIC_STRIPE_PAYMENT_LINK_15W=
# $3 test access for invited testers (page /payment/test). Remove to hide.
NEXT_PUBLIC_STRIPE_PAYMENT_LINK_TEST=

# Payment methods for people whose cards Stripe cannot accept (page
# /payment/other). Each block appears only when filled in; multi-line
# values are shown as written.
PAYMENT_ALT_BANK=
PAYMENT_ALT_CRYPTO=
PAYMENT_ALT_PAYPAL=
PAYMENT_ALT_WISE=
PAYMENT_ALT_OTHER=

# PayPal buttons next to the card ones (page /payment). Full https links
# from PayPal: a hosted button or a PayPal.me link with the amount.
NEXT_PUBLIC_PAYPAL_LINK_5W=
NEXT_PUBLIC_PAYPAL_LINK_15W=
NEXT_PUBLIC_PAYPAL_LINK_TEST=

# Server-only Stripe integration (webhook + automatic payment recording).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# AI assistants (server-only).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Which provider is asked first. Comma-separated ids; unknown names are
# ignored and anyone left out keeps their place at the back. Empty means the
# built-in order, which is Claude first — the same as the site today.
AI_PROVIDER_PRIORITY=

# Model and endpoint per provider. Empty means the built-in default, so a
# model change is a deployment decision rather than a code change. A
# base URL lets a gateway or a self-hosted compatible server stand in for
# the vendor without touching the product.
ANTHROPIC_MODEL=
ANTHROPIC_BASE_URL=
OPENAI_MODEL=
OPENAI_BASE_URL=

# How long one provider is given before the next one is asked (ms).
# Empty means 60000.
AI_REQUEST_TIMEOUT_MS=

# Public assistant protection (optional — safe defaults are built in).
# PUBLIC_ASSISTANT_MODE: open (default) | registered_only | off
PUBLIC_ASSISTANT_MODE=
ASSISTANT_DAILY_LIMIT_GUEST=
ASSISTANT_DAILY_LIMIT_REGISTERED=
ASSISTANT_DAILY_LIMIT_CLIENT=
ASSISTANT_DAILY_TOTAL_GUEST=
# Salt for hashing visitor addresses in the daily counters (never stored raw).
ASSISTANT_USAGE_SALT=

# Team notifications via Telegram (server-only): bot token from @BotFather
# and the chat id the team reads. Without these, notifications are logged
# with status "skipped" and nothing is sent.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Absolute site origin used in notification links and auth redirects.
NEXT_PUBLIC_SITE_URL=https://pythonmethodcenter.com
