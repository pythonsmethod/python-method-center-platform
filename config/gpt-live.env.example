# Add to the existing server environment only. Never use NEXT_PUBLIC_ for keys.
# Existing text backend keeps its existing OPENAI_API_KEY / Anthropic settings.
GPT_LIVE_ENABLED=false
GPT_LIVE_MODEL=gpt-live-1
GPT_LIVE_OPENAI_API_KEY=
GPT_LIVE_PILOT_EMAILS=
GPT_LIVE_VOICE=marin
GPT_LIVE_MAX_SECONDS=240
GPT_LIVE_DAILY_SESSIONS=6
# Active RU/EN UI locale is passed explicitly for every session.
